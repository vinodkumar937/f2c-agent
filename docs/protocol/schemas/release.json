      ],
      "description": "agent-release.json: an engine's pin of a release. Format 1: exactly 13 files. Format 2: 15 files plus caddy, keys, supersedes and rollback.",
      "allOf": [
        {
          "if": {
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "caddy",
              "keys"
            ],
            "properties": {
              "files": {
                "type": "object",
                "required": [
                  "SHA256SUMS.sigs",
                  "release-keys.json"
                ]
              }
            }
          }
        }
      ]
    },
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "The first 8 bytes of sha256 of the raw 32-byte public key, as 16 lowercase hex characters. Only a selector: the signature is always verified against the key the id names.",
      "examples": [
        "0123456789abcdef"
      ]
    },
    "releaseKeys": {
      "type": "object",
      "description": "keys/release-keys.json, the single source of the trusted release public keys (agent: embedded; install.sh: generated block; engine: trust file changed only through a signed release). active keys verify and may sign, retired keys verify only, revoked keys never verify and stay listed.",
      "properties": {
        "v": {
          "const": 1
        },
        "serial": {
          "type": "integer",
          "minimum": 1,
          "description": "Raised on every change of the list."
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/keyId"
              },
              "alg": {
                "const": "ed25519"
              },
              "pub": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{43}=$",
                "description": "Raw 32-byte Ed25519 public key, standard base64."
              },
              "status": {
                "enum": [
                  "active",
                  "retired",
                  "revoked"
                ]
              },
              "added": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "alg",
              "pub",
              "status"
            ],
            "additionalProperties": true
          },
          "minItems": 1
        }
      },
      "required": [
        "v",
        "serial",
        "keys"
      ],
      "additionalProperties": true,
      "examples": [
        {
          "v": 1,
          "serial": 1,
          "keys": [
            {
              "id": "0123456789abcdef",
              "alg": "ed25519",
              "pub": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
              "status": "active",
              "added": "2026-11-18",
              "note": "example key"
            }
          ]
        }
      ]
    },
    "sumsSigs": {
      "type": "object",
      "description": "SHA256SUMS.sigs: signatures over the exact bytes of SHA256SUMS, each naming its key by id. One valid signature by a trusted (active or retired) key is enough; unknown and revoked ids are skipped. The raw 64-byte SHA256SUMS.sig stays beside it for verifiers older than key ids.",
      "properties": {
        "v": {
          "const": 1
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyId": {
                "$ref": "#/$defs/keyId"
              },
              "alg": {
                "const": "ed25519"
              },
              "sig": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]{86}==$",
                "description": "64-byte signature, standard base64."
              }
            },
            "required": [
              "keyId",
              "alg",
              "sig"
            ],
            "additionalProperties": true
          },
          "minItems": 1
        }
      },
      "required": [
        "v",
        "signatures"
      ],
      "additionalProperties": true,
      "examples": [
        {
          "v": 1,
          "signatures": [
            {
              "keyId": "0123456789abcdef",
              "alg": "ed25519",
              "sig": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=="
            }
          ]
        }
      ]
    }
  }
}
