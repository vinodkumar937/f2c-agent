          "tag": "v0.4.0",
          "version": "0.4.0+202611201015",
          "format": 2,
          "files": {
            "SHA256SUMS": {
              "sha256": "3333333333333333333333333333333333333333333333333333333333333333",
              "size": 100
            },
            "SHA256SUMS.sig": {
              "sha256": "3333333333333333333333333333333333333333333333333333333333333333",
              "size": 100
            },
            "SHA256SUMS.sigs": {
              "sha256": "3333333333333333333333333333333333333333333333333333333333333333",
              "size": 100
            },
            "version.json": {
              "sha256": "3333333333333333333333333333333333333333333333333333333333333333",
