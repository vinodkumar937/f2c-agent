    "resultFailureV1": {
      "type": "object",
      "properties": {
        "t": {
          "const": "result"
        },
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "$ref": "common.json#/$defs/resultCodeV1"
        }
      },
      "required": [
        "t",
        "id",
        "ok",
        "error",
        "code"
      ],
      "not": {
        "required": [
          "data"
        ]
      },
      "additionalProperties": true,
      "examples": [
        {
          "t": "result",
          "id": "c10",
          "ok": false,
          "error": "docker pull: Error response from daemon: pull access denied for nginx, repository does not exist or may require 'docker login'",
          "code": "image_not_found"
        },
        {
          "t": "result",
          "id": "c11",
          "ok": false,
          "error": "docker run: Bind for 127.0.0.1:20001 failed: port is already allocated",
          "code": "port_in_use"
        },
        {
          "t": "result",
          "id": "c12",
          "ok": false,
          "error": "caddy admin: Post \"http://127.0.0.1:2019/load\": dial tcp 127.0.0.1:2019: connect: connection refused",
          "code": "caddy_unavailable"
        },
        {
          "t": "result",
          "id": "c13",
          "ok": false,
          "error": "harden_running: another harden run is still in progress on this agent; nothing changed",
          "code": "conflict"
        },
        {
          "t": "result",
          "id": "c14",
          "ok": false,
          "error": "build timed out: context deadline exceeded",
          "code": "timeout"
        },
        {
          "t": "result",
          "id": "c15",
          "ok": false,
          "error": "interrupted: the agent restarted while build was running; it may have partly run, check the state and retry with a new id",
          "code": "interrupted"
        }
      ],
      "description": "agent -> engine. The shape of every failed result at protocol >= 1: ok:false, the unchanged error text, a code from resultCodeV1, and no data."
    }
  }
