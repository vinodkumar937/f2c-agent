              "$ref": "common.json#/$defs/id"
            },
            "ok": {
              "const": false
            },
            "code": {
              "type": "string",
              "pattern": "^[a-z_]{1,64}$"
            },
            "status": {
              "type": "integer",
              "enum": [
                400,
                403,
                404,
                409,
                500
              ]
            }
          },
          "required": [
            "t",
            "id",
            "ok",
            "code",
            "status"
          ],
          "additionalProperties": true
        }
      ],
      "examples": [
        {
          "t": "db_result",
          "id": "db-1",
          "ok": true,
          "data": {
            "protocol": 1,
            "volumeDelete": true,
            "backups": true,
            "query": true,
            "writeQuery": true,
            "restoreUpload": true,
            "offsitePut": true,
            "volumeBackup": true
          }
        },
        {
          "t": "db_result",
          "id": "db-2",
          "ok": false,
          "code": "operation_busy",
          "status": 409
        }
      ]
    },
