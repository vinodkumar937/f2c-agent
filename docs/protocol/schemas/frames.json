          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "cmd": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "cols": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "helperTar": {
          "$ref": "common.json#/$defs/base64"
        },
        "helperDir": {
          "type": "string",
          "pattern": "^/tmp/\\.f2c/con_[a-f0-9]{16}$"
        },
        "fallbackCmd": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "t",
        "id",
        "container",
        "cmd"
      ],
      "additionalProperties": true,
      "examples": [
        {
          "t": "console_open",
