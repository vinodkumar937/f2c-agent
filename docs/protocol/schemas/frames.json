    "dbSpec": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "enum": [
            "postgres",
            "redis"
          ]
        },
        "orgId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "databaseName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "container": {
          "type": "string",
          "description": "Must equal f2c-db-<databaseName>."
        },
        "volume": {
          "type": "string",
          "description": "Must equal <container>-data."
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        }
      },
      "required": [
        "generation",
        "type",
        "orgId",
        "databaseName",
        "container",
        "volume",
        "user",
        "database"
      ],
      "additionalProperties": true,
      "description": "Identity of a managed database, the common args of every db_request (except capabilities, volume_backup_create and volume_backup_offsite) and of db_socket_open. Each operation adds its own arguments (see database.json).",
      "examples": [
        {
          "generation": "g1",
          "type": "postgres",
          "orgId": "org_EXAMPLE",
          "databaseName": "db1",
          "container": "f2c-db-db1",
          "volume": "f2c-db-db1-data",
          "user": "app",
          "database": "app"
        }
      ]
    },
    "dbRequest": {
      "type": "object",
      "properties": {
        "t": {
          "const": "db_request"
        },
        "id": {
          "$ref": "common.json#/$defs/id"
        },
        "type": {
          "type": "string",
          "description": "Operation: capabilities, register, backup_list, backup_create, backup_offsite_put, backup_offsite_restore, backup_close, backup_read, restore, upload_start, upload_chunk, upload_finish, upload_abort, delete, volume_backup_create, volume_backup_offsite. Unknown operations fail with code unsupported."
        },
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": true,
          "description": "Operation arguments. Every operation except capabilities, volume_backup_create and volume_backup_offsite carries the dbSpec identity fields plus its own; the per-operation arguments and results are in database.json (`<operation>.args`, `<operation>.result`)."
        }
      },
      "required": [
        "t",
        "id",
        "type"
      ],
      "additionalProperties": true,
      "examples": [
        {
          "t": "db_request",
          "id": "db-1",
          "type": "capabilities",
          "args": {}
        },
        {
          "t": "db_request",
          "id": "db-2",
          "type": "backup_list",
          "args": {
            "generation": "g1",
            "type": "postgres",
            "orgId": "org_EXAMPLE",
            "databaseName": "db1",
            "container": "f2c-db-db1",
            "volume": "f2c-db-db1-data",
            "user": "app",
            "database": "app"
          }
        }
      ]
    },
    "dbResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "db_result"
            },
            "id": {
              "$ref": "common.json#/$defs/id"
