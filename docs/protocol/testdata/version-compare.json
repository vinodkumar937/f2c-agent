{
 "v": 1,
 "about": "Shared test vectors for the self_update guard (docs/protocol.md section 8.4): used by this agent (internal/version CompareBuild and the self_update decision); an engine that implements the same guard should pass them too. Lives at docs/protocol/testdata/version-compare.json.",
 "rules": {
  "cmp": "sign of the semver precedence of target versus cur (build metadata ignored, a leading v is allowed); null when either side is not a valid semver or the target has no signed version",
  "build": "only when cmp == 0: 'newer' | 'older' | 'same' | 'unordered', the target's +build versus the current one. Both 12-digit UTC stamps (YYYYMMDDHHMM): numeric order. Both absent: 'same'. Anything else: 'unordered'.",
  "decision": "allow | up_to_date (same sha256 as the running binary; checked first) | refuse_no_rollback (needs rollback:true with a reason; this is also the fail-closed answer) | refuse_integrity (same version and build, different bytes) | refuse_floor (below the persisted signed floor; rollback never overrides it)",
  "order": "1 same sha256 -> up_to_date. 2 floor set and target below it (or unsigned) -> refuse_floor. 3 cmp > 0 -> allow. 4 build newer -> allow. 5 build same -> refuse_integrity. 6 everything else (cmp < 0, cmp null, build older or unordered) -> allow with rollback:true, else refuse_no_rollback."
 },
 "cases": [
  {
   "name": "newer release",
   "cur": "0.3.1+202611190800",
   "target": "0.4.0+202611201015",
   "rollback": false,
   "floor": null,
   "sameSha": false,
   "targetSigned": true,
   "expect": {
    "cmp": 1,
    "build": null,
    "decision": "allow"
   }
  },
  {
   "name": "older release, no flag",
   "cur": "0.4.0+202611201015",
   "target": "0.3.1+202611190800",
   "rollback": false,
   "floor": null,
   "sameSha": false,
   "targetSigned": true,
   "expect": {
    "cmp": -1,
    "build": null,
    "decision": "refuse_no_rollback"
   }
  },
  {
   "name": "older release, rollback",
   "cur": "0.4.0+202611201015",
   "target": "0.3.1+202611190800",
